# Leave these empty to run in "demo mode" (data is saved in this browser only).
# Fill them in with your Supabase project's values to share data across every
# phone and computer. See README.md, "Going live".
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Your website's public address (e.g. https://cincyrocks.com). Invite QR codes made in
# the phone apps point here. The GitHub Pages workflow fills it in from CUSTOM_DOMAIN.
VITE_SITE_URL=
